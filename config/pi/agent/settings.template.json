{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "collapseChangelog": true,
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000
  },
  "npmCommand": ["pnpm"],
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra"
  },
  "packages": "__PI_SETUP_DEFAULT_PACKAGES__",
  "extensions": [
    "__PI_SETUP_ROOT__/packages/extensions/usage-insights/dist/index.mjs",
    "__PI_SETUP_ROOT__/packages/extensions/minimal-output/dist/index.mjs",
    "__PI_SETUP_ROOT__/packages/extensions/tool-pruner/dist/index.mjs",
    "__PI_SETUP_ROOT__/packages/extensions/context-management/dist/index.mjs"
  ]
}
